{
  "name": "to-do-list",
  "version": "1.0.0",
  "description": "to do list",
  "private": true,
  "scripts": {
    "lint:html": "htmlhint \"*.html\"",
    "lint:css": "stylelint \"*.css\"",
    "lint:js": "eslint \"*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "htmlhint": "^1.1.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lodash": "^4.17.11",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  }
}
